<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.golf.erp.audit.AuditLogMapper">

	<sql id="where">
		<where>
			<if test="entityType != null and entityType != ''">AND entity_type = #{entityType}</if>
			<if test="entityId != null">AND entity_id = #{entityId}</if>
		</where>
	</sql>

	<select id="search" resultType="com.golf.erp.audit.AuditLogRow">
		SELECT audit_log_id, actor_username, action, entity_type, entity_id, details::text AS details, created_at
		  FROM golf.audit_log
		<include refid="where" />
		 ORDER BY created_at DESC, audit_log_id DESC
		 LIMIT #{size} OFFSET #{offset}
	</select>

	<select id="count" resultType="long">
		SELECT COUNT(*) FROM golf.audit_log
		<include refid="where" />
	</select>
</mapper>
