>  file_size_bytes BIGINT NOT NULL,
>  checksum_sha256 CHAR(64),
>  image_width INTEGER,
>  image_height INTEGER,
>  upload_status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',
>  uploaded_by_member_id BIGINT REFERENCES golf.member(member_id),
>  uploaded_by_admin_user_id BIGINT REFERENCES golf.admin_user(admin_user_id),
>  uploaded_at TIMESTAMP(6) NOT NULL DEFAULT LOCALTIMESTAMP,
>  deleted_at TIMESTAMP(6),
>  CONSTRAINT ck_common_file_category CHECK (file_category IN ('IMAGE','DOCUMENT','OTHER')),
>  CONSTRAINT ck_common_file_size CHECK (file_size_bytes > 0),
>  CONSTRAINT ck_common_file_image_size CHECK (
>    (image_width IS NULL AND image_height IS NULL)
>    OR (image_width > 0 AND image_height > 0)),
>  CONSTRAINT ck_common_file_upload_status CHECK (upload_status IN ('ACTIVE','QUARANTINED','DELETED')),
>  CONSTRAINT ck_common_file_uploader CHECK (
>    uploaded_by_member_id IS NOT NULL OR uploaded_by_admin_user_id IS NOT NULL)
> );
> CREATE INDEX IF NOT EXISTS ix_common_file_category_date
>  ON golf.common_file(file_category, uploaded_at DESC);
> CREATE INDEX IF NOT EXISTS ix_common_file_member
>  ON golf.common_file(uploaded_by_member_id, uploaded_at DESC);
> 
> -- 게시글에 이미지/첨부 파일을 여러 개 연결
> CREATE TABLE IF NOT EXISTS golf.board_file (
>  board_id BIGINT NOT NULL REFERENCES golf.board(board_id) ON DELETE CASCADE,
>  common_file_id BIGINT NOT NULL REFERENCES golf.common_file(common_file_id),
>  display_order SMALLINT NOT NULL DEFAULT 0,
>  caption VARCHAR(300),
>  attached_at TIMESTAMP(6) NOT NULL DEFAULT LOCALTIMESTAMP,
>  PRIMARY KEY(board_id, common_file_id),
>  CONSTRAINT ck_board_file_order CHECK (display_order >= 0)
> );
