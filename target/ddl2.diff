> CREATE TABLE IF NOT EXISTS golf.store_order (
>  store_order_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
>  store_id BIGINT NOT NULL REFERENCES golf.tenant_store(store_id),
>  order_no VARCHAR(40) NOT NULL UNIQUE,
>  member_id BIGINT REFERENCES golf.member(member_id),
